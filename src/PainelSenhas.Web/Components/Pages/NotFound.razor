@page "/not-found"
@attribute [AllowAnonymous]
@layout MainLayout

<PageTitle>Página não encontrada • Senha</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudText Typo="Typo.h4" Class="mb-2">Página não encontrada</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">O endereço que você procura não existe.</MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">Voltar ao início</MudButton>
</MudContainer>
