@page "/entrar"
@attribute [AllowAnonymous]

<PageTitle>Entrar • Senha</PageTitle>

<MudPaper Class="pa-8 mx-auto my-8" Style="max-width: 470px" Outlined="true">
    <MudText Typo="Typo.overline" Color="Color.Primary">ÁREA DA EQUIPE</MudText>
    <MudText Typo="Typo.h4" Class="mb-2">Bom atendimento começa aqui.</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">Use a conta fornecida pelo administrador.</MudText>

    @if (Error == "1")
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4" role="alert">
            Não foi possível entrar. Confira os dados ou aguarde alguns minutos antes de tentar novamente.
        </MudAlert>
    }

    <form method="post" action="/conta/entrar" data-enhance="false" class="plain-form">
        <AntiforgeryToken />
        <label>Usuário<input name="username" autocomplete="username" required maxlength="100" /></label>
        <label>Senha de acesso<input name="password" type="password" autocomplete="current-password" required /></label>
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true">Entrar</MudButton>
    </form>
</MudPaper>
