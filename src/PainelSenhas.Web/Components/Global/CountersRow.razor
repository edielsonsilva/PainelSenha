<div class="counters">
    <MudPaper Outlined="true" Class="counter">
        <span class="counter-value">@Pending</span>
        <span class="counter-label">Na fila</span>
    </MudPaper>
    <MudPaper Outlined="true" Class="counter">
        <span class="counter-value">@Completed</span>
        <span class="counter-label">Concluídas hoje</span>
    </MudPaper>
    <MudPaper Outlined="true" Class="counter">
        <span class="counter-value">@Absent</span>
        <span class="counter-label">Não atendidas hoje</span>
    </MudPaper>
</div>
