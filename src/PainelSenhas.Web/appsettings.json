{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer"
  },
  "Deployment": {
    "RequireHttps": true
  },
  "Unit": {
    "TimeZone": "America/Cuiaba"
  },
  "Printing": {
    "Layout": "Thermal80",
    "AutoPrint": true
  }
}
